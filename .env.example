# Conexão com o Postgres (único backend, slice #48).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/youtube_index

# Chave da YouTube Data API usada para resolver handles e ingerir Canais.
# (API v3, parte "Data API". Criada no Google Cloud Console.)
YOUTUBE_API_KEY=

# Intervalo em ms entre ticks do loop de Ingestão em-processo (#47).
POLL_INTERVAL_MS=1000

# Endereço/porta em que o api escuta.
HOST=0.0.0.0
PORT=3000

# Diretório do build estático do web. Quando definido, o api serve os
# assets do SPA em rotas não-API. Vazio em dev (web roda via vite).
WEB_DIST_DIR=
