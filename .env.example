# Master key do Meilisearch. Fica no servidor (contêineres), nunca no browser.
# Copie para .env e troque por uma chave forte no uso real.
MEILI_MASTER_KEY=youtube-index-dev-master-key

# Chave da YouTube Data API usada para resolver handles e ingerir Canais.
# (API v3, parte "Data API". Criada no Google Cloud Console.)
YOUTUBE_API_KEY=

# Caminho do banco SQLite (Fonte da verdade). Padrão: data/youtube-index.db
DB_PATH=data/youtube-index.db